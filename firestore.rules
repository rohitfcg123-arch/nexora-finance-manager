rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may access only their own profile and finance data.
    match /users/{userId} {
      allow read, create, update, delete:
        if request.auth != null
        && request.auth.uid == userId;

      // Suggested user-owned collections:
      // transactions, accounts, categories, rules, imports.
      match /{document=**} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Deny access to every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
